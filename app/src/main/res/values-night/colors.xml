    <color name="success">#FF6AD4A4</color>
    <color name="success_light">#FF005237</color>

    <color name="surface">#FF17171C</color>
    <color name="surface_alt">#FF22242A</color>
    <color name="text">#FFE5E8EB</color>
    <color name="text_sub">#FFB0B8C1</color>
