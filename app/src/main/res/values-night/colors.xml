<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Semantic 토큰 다크 값. values/colors.xml 의 별칭(color_*, siru_*)은
         참조로 정의돼 있어 여기서 다시 선언하지 않아도 따라온다. -->
    <color name="primary">#FFFFBDAA</color>
    <color name="primary_light">#FF8A2F19</color>
    <color name="primary_dark">#FFFFE7DE</color>

    <color name="danger">#FFFFB4AB</color>
