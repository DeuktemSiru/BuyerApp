<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_light_surface"
    android:paddingHorizontal="@dimen/spacing_lg">

    <LinearLayout
        android:id="@+id/ll_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:layout_gravity="end"
            android:contentDescription="시흥시 캐릭터"
            android:scaleType="fitCenter"
            android:src="@drawable/img_siheung_character" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="득템시루"
            android:textColor="@color/primary"
            android:textSize="@dimen/text_display" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:fontFamily="sans-serif-medium"
            android:text="로그인하고"
            android:textColor="@color/color_text"
            android:textSize="@dimen/text_headline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="오늘의 남은 맛을 구해요"
            android:textColor="@color/color_text"
            android:textSize="@dimen/text_headline" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="카카오로 간편하게 시작해보세요."
            android:textColor="@color/color_text_sub"
            android:textSize="@dimen/text_body" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/login_button_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_kakao_login"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cta_button_height"
            android:fontFamily="sans-serif-medium"
            android:text="카카오로 시작하기"
            android:textColor="#191919"
            android:textSize="@dimen/text_button"
            app:backgroundTint="#FEE500"
            app:cornerRadius="@dimen/radius_md" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_debug_login"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cta_button_height"
            android:layout_marginTop="@dimen/spacing_sm"
            android:fontFamily="sans-serif-medium"
            android:text="디버그 로그인으로 시작하기"
            android:textColor="@color/color_button_dark_text"
            android:textSize="@dimen/text_button"
            android:visibility="gone"
            app:backgroundTint="@color/color_text"
            app:cornerRadius="@dimen/radius_md" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
