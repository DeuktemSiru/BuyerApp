<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
    <item android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_theme_light_secondaryContainer" />
            <stroke android:width="0.5dp" android:color="@color/color_border_light" />
            <corners android:radius="@dimen/radius_sm" />
        </shape>
    </item>
</layer-list>
