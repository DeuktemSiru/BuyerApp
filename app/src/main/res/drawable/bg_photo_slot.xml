<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_highlight" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/color_border"
                android:dashWidth="6dp"
                android:dashGap="4dp" />
            <corners android:radius="@dimen/radius_md" />
        </shape>
    </item>
</layer-list>
